s/v/inter/5.2.8/cyrillic/wght/normal.woff2);unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;font-display:swap;}@font-face {font-family:'Inter';font-style:normal;font-weight:800;src:url(/cf-fonts/v/inter/5.2.8/greek-ext/wght/normal.woff2);unicode-range:U+1F00-1FFF;font-display:swap;}@font-face {font-family:'Inter';font-style:normal;font-weight:800;src:url(/cf-fonts/v/inter/5.2.8/latin-ext/wght/normal.woff2);unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;font-display:swap;}@font-face {font-family:'Inter';font-style:normal;font-weight:800;src:url(/cf-fonts/v/inter/5.2.8/latin/wght/normal.woff2);unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;font-display:swap;}</style>
    <style>
        /* ── Design Tokens ─────────────────────────────────── */
        :root {
            --bg:          #f8f9fa;
            --surface:     #ffffff;
            --surface-2:   #f4f4f6;
            --border:      #e5e7eb;
            --border-soft: #f0f0f2;
            --text:        #111827;
            --text-2:      #374151;
            --text-muted:  #6b7280;
            --text-faint:  #9ca3af;

            --up:          #10b981;
            --up-bg:       #ecfdf5;
            --up-border:   #a7f3d0;
            --up-text:     #065f46;

            --warn:        #f59e0b;
            --warn-bg:     #fffbeb;
            --warn-border: #fde68a;
            --warn-text:   #78350f;

            --down:        #ef4444;
            --down-bg:     #fef2f2;
            --down-border: #fecaca;
            --down-text:   #991b1b;

            --accent:      #6366f1;
            --accent-2:    #8b5cf6;

            --radius-sm:   6px;
            --radius-md:   10px;
            --radius-lg:   14px;

            --shadow-sm:   0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
            --shadow-md:   0 4px 16px rgba(0,0,0,0.08), 0 1px 4px rgba(0,0,0,0.04);

            --transition:  0.18s ease;
        }

        [data-theme="dark"] {
            --bg:          #0d1117;
            --surface:     #161b22;
            --surface-2:   #1c2128;
            --border:      #30363d;
            --border-soft: #21262d;
            --text:        #e6edf3;
            --text-2:      #c9d1d9;
            --text-muted:  #8b949e;
            --text-faint:  #6e7681;

            --up-bg:       #0d2b1e;
            --up-border:   #1a4731;
            --up-text:     #3fb950;

            --warn-bg:     #2b1e08;
            --warn-border: #5a3e0a;
            --warn-text:   #d29922;

            --down-bg:     #2b1218;
            --down-border: #5a1c24;
            --down-text:   #f85149;

            --shadow-sm:   0 1px 3px rgba(0,0,0,0.3);
            --shadow-md:   0 4px 16px rgba(0,0,0,0.4);
        }

        /* ── Reset ─────────────────────────────────────────── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg);
            color: var(--text);
            font-size: 14px;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            transition: background var(--transition), color var(--transition);
        }

        /* ── Layout ────────────────────────────────────────── */
        .wrap { max-width: 860px; margin: 0 auto; padding: 0 20px; }

        /* ── Header ────────────────────────────────────────── */
        .site-header {
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            position: sticky; top: 0; z-index: 100;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        .header-inner {
            display: flex; align-items: center; justify-content: space-between;
            height: 56px;
        }
        .logo {
            display: flex; align-items: center; gap: 10px;
            text-decoration: none; color: var(--text);
        }
        .logo-mark {
            width: 30px; height: 30px; border-radius: 8px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; font-size: 14px; color: #fff;
            box-shadow: 0 2px 8px rgba(99,102,241,0.35);
        }
        .logo-text { font-size: 15px; font-weight: 700; letter-spacing: -0.3px; }

        .header-right { display: flex; align-items: center; gap: 12px; }
        .last-updated {
            font-size: 12px; color: var(--text-faint);
            display: flex; align-items: center; gap: 5px;
        }
        .live-dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--up); display: inline-block;
            animation: pulse-dot 2s infinite;
        }
        @keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(0.8); }
        }

        .theme-btn {
            width: 32px; height: 32px; border-radius: var(--radius-sm);
            border: 1px solid var(--border); background: var(--surface-2);
            color: var(--text-muted); cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px; transition: all var(--transition);
        }
        .theme-btn:hover { background: var(--border); color: var(--text); }

        /* ── Page body ─────────────────────────────────────── */
        .page-body { padding: 36px 0 60px; }

        /* ── Status Banner ─────────────────────────────────── */
        .status-banner {
            border-radius: var(--radius-lg);
            padding: 24px 28px;
            margin-bottom: 28px;
            border: 1px solid;
            position: relative; overflow: hidden;
            transition: all var(--transition);
        }
        .status-banner::before {
            content: '';
            position: absolute; inset: 0;
            opacity: 0.05;
            background: radial-gradient(ellipse at top left, currentColor 0%, transparent 70%);
            pointer-events: none;
        }
        .status-banner.operational {
            background: var(--up-bg); border-color: var(--up-border); color: var(--up-text);
        }
        .status-banner.degraded {
            background: var(--warn-bg); border-color: var(--warn-border); color: var(--warn-text);
        }
        .status-banner.outage {
            background: var(--down-bg); border-color: var(--down-border); color: var(--down-text);
        }

        .banner-body { display: flex; align-items: center; gap: 14px; }
        .banner-icon { font-size: 28px; flex-shrink: 0; line-height: 1; }
        .banner-title { font-size: 20px; font-weight: 700; letter-spacing: -0.4px; margin-bottom: 3px; }
        .banner-sub { font-size: 13px; opacity: 0.8; }

        /* ── Stats Row ─────────────────────────────────────── */
        .stats-row {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
            margin-bottom: 28px;
        }
        .stat-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius-md); padding: 18px 20px;
            box-shadow: var(--shadow-sm);
            transition: box-shadow var(--transition);
        }
        .stat-card:hover { box-shadow: var(--shadow-md); }
        .stat-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.6px; color: var(--text-muted); margin-bottom: 6px; }
        .stat-value { font-size: 26px; font-weight: 800; letter-spacing: -0.8px; font-variant-numeric: tabular-nums; color: var(--text); }
        .stat-value span { font-size: 14px; font-weight: 500; color: var(--text-muted); letter-spacing: 0; }
        .stat-sub { font-size: 11px; color: var(--text-faint); margin-top: 3px; }

        /* ── Status Card ───────────────────────────────────── */
        .status-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);
            overflow: hidden; margin-bottom: 20px;
        }

        .card-header {
            padding: 18px 24px; border-bottom: 1px solid var(--border-soft);
            display: flex; justify-content: space-between; align-items: center;
            background: var(--surface);
        }
        .card-title { font-size: 15px; font-weight: 700; letter-spacing: -0.2px; }
        .date-range { font-size: 12px; color: var(--text-muted); display: flex; align-items: center; gap: 4px; }

        /* Project group */
        .project-group { border-bottom: 1px solid var(--border-soft); }
        .project-group:last-child { border-bottom: none; }

        .project-label {
            padding: 10px 24px; font-size: 11px; font-weight: 600;
            text-transform: uppercase; letter-spacing: 0.6px;
            color: var(--text-faint); background: var(--surface-2);
            border-bottom: 1px solid var(--border-soft);
        }

        /* Component row */
        .comp-row {
            padding: 18px 24px;
            border-bottom: 1px solid var(--border-soft);
            transition: background var(--transition);
        }
        .comp-row:last-child { border-bottom: none; }
        .comp-row:hover { background: var(--surface-2); }

        .comp-info {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 12px;
        }
        .comp-left { display: flex; align-items: center; gap: 8px; }
        .status-dot {
            width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
            transition: background var(--transition);
        }
        .status-dot.up   { background: var(--up); box-shadow: 0 0 0 2px rgba(16,185,129,0.2); }
        .status-dot.down { background: var(--down); box-shadow: 0 0 0 2px rgba(239,68,68,0.2); animation: pulse-down 1.5s infinite; }
        .status-dot.warn { background: var(--warn); box-shadow: 0 0 0 2px rgba(245,158,11,0.2); }
        @keyframes pulse-down {
            0%, 100% { box-shadow: 0 0 0 2px rgba(239,68,68,0.2); }
            50% { box-shadow: 0 0 0 5px rgba(239,68,68,0.05); }
        }

        .comp-name { font-size: 14px; font-weight: 500; color: var(--text-2); }
        .comp-status-badge {
            font-size: 11px; font-weight: 600; padding: 2px 8px;
            border-radius: 20px; background: var(--up-bg); color: var(--up-text);
            border: 1px solid var(--up-border);
        }
        .comp-status-badge.down { background: var(--down-bg); color: var(--down-text); border-color: var(--down-border); }

        .comp-right { display: flex; align-items: center; gap: 14px; }
        .comp-meta { font-size: 12px; color: var(--text-muted); font-variant-numeric: tabular-nums; text-align: right; }
        .comp-meta strong { color: var(--text); font-weight: 600; }
        .latency-badge {
            font-size: 11px; padding: 2px 7px; border-radius: 4px;
            background: var(--surface-2); color: var(--text-muted);
            border: 1px solid var(--border); font-variant-numeric: tabular-nums;
        }

        /* ── Bar Chart ─────────────────────────────────────── */
        .bars-wrap {
            display: flex; gap: 3px; height: 32px; align-items: flex-end;
        }
        .bar {
            flex: 1; min-width: 0; border-radius: 3px;
            height: 100%; position: relative; cursor: pointer;
            transition: opacity var(--transition), transform 0.1s ease;
        }
        .bar:hover { opacity: 0.75; transform: scaleY(1.06); transform-origin: bottom; }
        .bar.c-100  { background: var(--up); }
        .bar.c-good { background: #34d399; }
        .bar.c-bad  { background: var(--down); }
        .bar.c-none { background: var(--border); opacity: 0.6; }
        .bar.c-nodata { 
            background: repeating-linear-gradient(
                45deg,
                var(--border-soft),
                var(--border-soft) 4px,
                var(--border) 4px,
                var(--border) 8px
            );
            opacity: 0.6;
        }

        /* ── Modals & Filters ─────────────────────────────── */
        .modal-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,0.5);
            display: flex; align-items: center; justify-content: center;
            z-index: 1000; padding: 20px;
            opacity: 0; pointer-events: none; transition: opacity 0.2s;
        }
        .modal-overlay.open { opacity: 1; pointer-events: auto; }
        .modal-content {
            background: var(--surface); width: 100%; max-width: 650px;
            border-radius: var(--radius-lg); box-shadow: var(--shadow-md);
            display: flex; flex-direction: column; max-height: 85vh;
            transform: translateY(10px); transition: transform 0.2s;
        }
        .modal-overlay.open .modal-content { transform: translateY(0); }
        .modal-header {
            padding: 16px 24px; border-bottom: 1px solid var(--border-soft);
            display: flex; justify-content: space-between; align-items: center;
        }
        .modal-header h2 { font-size: 16px; margin: 0; }
        .modal-close {
            background: none; border: none; font-size: 22px; cursor: pointer;
            color: var(--text-muted); line-height: 1; padding: 0 4px;
        }
        .modal-tabs {
            display: flex; gap: 8px; padding: 12px 24px;
            background: var(--surface-2); border-bottom: 1px solid var(--border-soft);
        }
        .tab-btn {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius-sm); padding: 4px 12px; font-size: 12px;
            cursor: pointer; color: var(--text-muted);
        }
        .tab-btn.active { background: var(--text); color: var(--surface); border-color: var(--text); }
        .modal-body {
            padding: 0; overflow-y: auto; flex: 1;
        }
        .modal-body .project-group { border-bottom: none; }
        .modal-body .comp-row { padding: 16px 24px; }
        
        .filter-bar {
            display: flex; justify-content: space-between; align-items: center;
            padding: 16px 24px; border-bottom: 1px solid var(--border-soft);
            background: var(--surface); gap: 12px; flex-wrap: wrap;
        }
        .search-input {
            padding: 8px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm);
            background: var(--surface-2); color: var(--text); font-size: 13px;
            flex: 1; min-width: 200px;
        }
        .toggle-btn {
            padding: 8px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm);
            background: var(--surface); color: var(--text-muted); font-size: 13px;
            cursor: pointer; font-weight: 500;
        }
        .toggle-btn.active { background: var(--warn-bg); color: var(--warn-text); border-color: var(--warn-border); }

        .attention-banner {
            background: var(--down-bg); border: 1px solid var(--down-border);
            border-radius: var(--radius-lg); padding: 16px 20px;
            margin-bottom: 20px; display: none;
        }
        .attention-banner.visible { display: block; }
        .attention-title { font-weight: 700; color: var(--down-text); margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
        .attention-links a { color: var(--down-text); text-decoration: underline; margin-right: 12px; font-size: 13px; }

        .proj-badge {
            font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px;
            margin-left: 8px; text-transform: uppercase;
        }
        .proj-badge.up { background: var(--up-bg); color: var(--up-text); border: 1px solid var(--up-border); }
        .proj-badge.warn { background: var(--warn-bg); color: var(--warn-text); border: 1px solid var(--warn-border); }
        .proj-badge.down { background: var(--down-bg); color: var(--down-text); border: 1px solid var(--down-border); }
        
        .legend-row {
            display: flex; gap: 16px; justify-content: center; padding: 12px;
            font-size: 11px; color: var(--text-muted); margin-top: 10px; flex-wrap: wrap;
        }
        .legend-item { display: flex; align-items: center; gap: 6px; }
        .legend-color { width: 12px; height: 12px; border-radius: 2px; }

        /* Tooltip */
        .bar-tip {
            display: none;
            position: absolute; bottom: calc(100% + 10px); left: 50%; transform: translateX(-50%);
            background: var(--text); color: var(--surface);
            padding: 10px 14px; border-radius: var(--radius-md);
            font-size: 12px; white-space: nowrap; min-width: 200px;
            box-shadow: var(--shadow-md); z-index: 200; text-align: left;
            pointer-events: none;
        }
        .bar-tip::after {
            content: ''; position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
            border: 5px solid transparent; border-top-color: var(--text);
        }
        .bar:hover .bar-tip { display: block; }
        .tip-date { color: rgba(255,255,255,0.55); font-size: 11px; margin-bottom: 6px; }
        [data-theme="dark"] .tip-date { color: rgba(0,0,0,0.5); }
        .tip-uptime { font-weight: 700; font-size: 13px; margin-bottom: 4px; }
        .tip-outage { display: flex; justify-content: space-between; align-items: center; margin-top: 6px; padding-top: 6px; border-top: 1px solid rgba(255,255,255,0.12); gap: 12px; }
        [data-theme="dark"] .tip-outage { border-top-color: rgba(0,0,0,0.15); }
        .tip-outage-label { color: #fbbf24; font-weight: 600; }
        .tip-outage-time { color: rgba(255,255,255,0.7); font-size: 11px; margin-top: 2px; }
        [data-theme="dark"] .tip-outage-time { color: rgba(0,0,0,0.5); }
        .tip-no-incidents { color: rgba(255,255,255,0.65); font-size: 11px; margin-top: 4px; }
        [data-theme="dark"] .tip-no-incidents { color: rgba(0,0,0,0.5); }

        .bars-label {
            display: flex; justify-content: space-between;
            font-size: 10px; color: var(--text-faint); margin-top: 6px;
        }

        /* ── Recent Outages Section ────────────────────────── */
        .incidents-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);
            overflow: hidden; margin-bottom: 20px;
        }
        .incidents-empty {
            padding: 36px 24px; text-align: center;
            color: var(--text-muted); font-size: 13px;
        }
        .incidents-empty .ei-icon { font-size: 32px; margin-bottom: 10px; }

        .incident-row {
            display: flex; align-items: flex-start; gap: 14px;
            padding: 16px 24px; border-bottom: 1px solid var(--border-soft);
            transition: background var(--transition);
        }
        .incident-row:last-child { border-bottom: none; }
        .incident-row:hover { background: var(--surface-2); }

        .incident-icon { font-size: 18px; margin-top: 1px; flex-shrink: 0; }
        .incident-body { flex: 1; min-width: 0; }
        .incident-service {
            font-weight: 600; font-size: 13px; color: var(--text);
            display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
        }
        .ongoing-badge {
            font-size: 10px; font-weight: 700; padding: 2px 7px;
            background: var(--down-bg); color: var(--down-text);
            border: 1px solid var(--down-border); border-radius: 20px;
            text-transform: uppercase; letter-spacing: 0.4px;
            animation: fade-ongoing 1.5s infinite;
        }
        @keyframes fade-ongoing { 0%,100%{opacity:1} 50%{opacity:0.55} }
        .incident-time { font-size: 12px; color: var(--text-muted); margin-top: 3px; }
        .incident-duration {
            font-size: 13px; font-weight: 600; color: var(--text-muted);
            white-space: nowrap; flex-shrink: 0; font-variant-numeric: tabular-nums;
        }

        /* ── Skeleton ──────────────────────────────────────── */
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }
        .skeleton {
            background: linear-gradient(90deg,
                var(--border-soft) 25%,
                var(--border) 50%,
                var(--border-soft) 75%
            );
            background-size: 200% 100%;
            animation: shimmer 1.6s infinite;
            border-radius: var(--radius-md);
        }
        .skel-banner { height: 90px; margin-bottom: 28px; }
        .skel-stats { height: 88px; margin-bottom: 28px; border-radius: var(--radius-lg); }
        .skel-card { height: 380px; }

        /* ── Footer ────────────────────────────────────────── */
        .site-footer {
            border-top: 1px solid var(--border);
            padding: 24px 0 32px;
            text-align: center; font-size: 12px; color: var(--text-faint);
        }
        .site-footer a { color: var(--text-muted); text-decoration: none; font-weight: 500; }
        .site-footer a:hover { color: var(--text); text-decoration: underline; }

        /* ── Responsive ────────────────────────────────────── */
        @media (max-width: 768px) {
            .stats-row { grid-template-columns: repeat(2, 1fr); }
            .stats-row .stat-card:last-child { grid-column: span 2; }
            .modal-content { max-height: 95vh; margin: 10px; }
        }
        
        @media (max-width: 600px) {
            .stats-row { grid-template-columns: 1fr; }
            .stats-row .stat-card:last-child { grid-column: auto; }
            
            .comp-info { flex-direction: column; align-items: flex-start; gap: 10px; }
            .comp-right { flex-direction: row; align-items: center; justify-content: space-between; width: 100%; gap: 6px; }
            .comp-meta { text-align: left; }
            
            .header-right .last-updated { display: none; }
            
            .incident-row { flex-direction: column; }
            .incident-duration { align-self: flex-start; margin-top: 4px; margin-left: 32px; }
            .incident-time { margin-bottom: 2px; }
        }
        
        @media (max-width: 420px) {
            .wrap { padding: 0 14px; }
            .comp-row { padding: 14px 16px; }
            .card-header { padding: 14px 16px; }
            .bars-wrap { height: 26px; }
            
            .banner-title { font-size: 18px; }
            .stat-value { font-size: 22px; }
        }

        /* ── Animations ────────────────────────────────────── */
        @keyframes fade-in {
            from { opacity: 0; transform: translateY(6px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-in { animation: fade-in 0.3s ease both; }
    </style>
</head>
<body>

<!-- Header -->
<header class="site-header">
    <div class="wrap">
        <div class="header-inner">
            <a href="/" class="logo" id="site-logo">
                <div class="logo-mark">D</div>
                <span class="logo-text" id="logo-name">Server Status</span>
            </a>
            <div class="header-right">
                <div class="last-updated" id="last-updated-label">
                    <span class="live-dot"></span>
                    <span id="last-updated-text">Loading…</span>
                </div>
                <button class="theme-btn" id="theme-toggle" title="Toggle theme" aria-label="Toggle dark/light theme">🌙</button>
            </div>
        </div>
    </div>
</header>

<!-- Main -->
<main>
    <div class="wrap">
        <div class="page-body">
            <div id="app-root">
                <!-- Skeleton -->
                <div class="skeleton skel-banner"></div>
                <div class="skeleton skel-stats"></div>
                <div class="skeleton skel-card"></div>
            </div>
            
            <div class="legend-row fade-in" id="legend" style="display:none">
                <div class="legend-item"><div class="legend-color" style="background: var(--up)"></div> 100% ishlash vaqti</div>
                <div class="legend-item"><div class="legend-color" style="background: #34d399"></div> &ge; 90%</div>
                <div class="legend-item"><div class="legend-color" style="background: var(--warn)"></div> &ge; 50%</div>
                <div class="legend-item"><div class="legend-color" style="background: var(--down)"></div> &lt; 50%</div>
                <div class="legend-item"><div class="legend-color c-nodata"></div> Ma'lumot yo'q</div>
            </div>
        </div>
    </div>
</main>

<!-- Modals -->
<div id="project-modal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="modal-project-name">Loyiha tafsilotlari</h2>
            <button class="modal-close" onclick="closeModal()">&times;</button>
        </div>
        <div class="modal-tabs">
            <button class="tab-btn active" id="tab-7d" onclick="loadProjectRange('7d')">7 kun</button>
            <button class="tab-btn" id="tab-30d" onclick="loadProjectRange('30d')">30 kun</button>
            <button class="tab-btn" id="tab-90d" onclick="loadProjectRange('90d')">90 kun</button>
        </div>
        <div class="modal-body" id="modal-body-content">
            <div style="padding: 24px; text-align: center; color: var(--text-muted);">Yuklanmoqda...</div>
        </div>
    </div>
</div>

<!-- Footer -->
<footer class="site-footer">
    <div class="wrap">
        Powered by <a href="https://status.darrov.uz" id="footer-link">Server Status Monitor</a>
        &nbsp;·&nbsp;
        <span id="footer-updated">Hozirgina yangilandi</span>
    </div>
</footer>

<script>
    'use strict';

    const API_URL = '/api/public/status';
    const root = document.getElementById('app-root');

    // ── Theme ──────────────────────────────────────────────
    const themeBtn = document.getElementById('theme-toggle');
    const html = document.documentElement;
    const saved = localStorage.getItem('theme') || 'light';
    html.setAttribute('data-theme', saved);
    themeBtn.textContent = saved === 'dark' ? '☀️' : '🌙';

    themeBtn.addEventListener('click', () => {
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        themeBtn.textContent = next === 'dark' ? '☀️' : '🌙';
    });

    // ── Helpers ────────────────────────────────────────────
    function fmtDuration(secs) {
        if (!secs || secs <= 0) return '< 1 daq';
        const h = Math.floor(secs / 3600);
        const m = Math.floor((secs % 3600) / 60);
        if (h === 0 && m === 0) return '< 1 daq';
        let s = '';
        if (h > 0) s += `${h}s `;
        if (m > 0 || h === 0) s += `${m}d`;
        return s.trim();
    }

    function fmtTime(isoStr) {
        if (!isoStr) return '—';
        try {
            return new Date(isoStr).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
        } catch (e) { return isoStr; }
    }

    function fmtDateTime(isoStr) {
        if (!isoStr) return '—';
        try {
            const d = new Date(isoStr);
            return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        } catch (e) { return isoStr; }
    }

    function fmtDate(dateStr) {
        try {
            return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        } catch (e) { return dateStr; }
    }

    function timeAgo(isoStr) {
        if (!isoStr) return 'hozirgina';
        try {
            const diff = Math.floor((Date.now() - new Date(isoStr)) / 1000);
            if (diff < 60) return 'hozirgina';
            if (diff < 3600) return `${Math.floor(diff/60)} daqiqa oldin`;
            if (diff < 86400) return `${Math.floor(diff/3600)} soat oldin`;
            return fmtDateTime(isoStr);
        } catch (e) { return 'hozirgina'; }
    }

    function escHtml(str) {
        return String(str)
            .replace(/&/g,'&amp;')
            .replace(/</g,'&lt;')
            .replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;');
    }

    // ── Fetch ──────────────────────────────────────────────
    async function fetchStatus() {
        try {
            const res = await fetch(API_URL + '?t=' + Date.now());
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();
            render(data);
        } catch (err) {
            renderError(err.message);
        }
    }

    // ── Render ─────────────────────────────────────────────
    function render(data, filterQuery = '', showOnlyIssues = false) {
        window.appData = data;
        // Update header labels
        const siteName = data.site_name || 'Server Status';
        document.title = siteName + ' — ' + (data.status || 'Status');
        document.getElementById('logo-name').textContent = siteName;
        document.getElementById('footer-link').textContent = siteName + ' Monitor';
        document.getElementById('last-updated-text').textContent = 'Yangilandi: ' + timeAgo(data.last_updated);
        document.getElementById('footer-updated').textContent = 'Yangilandi: ' + timeAgo(data.last_updated);

        // Status banner
        let bannerClass = 'operational';
        let bannerIcon = '✅';
        let bannerTitle = "Barcha tizimlar ishlamoqda";
        let bannerSub = "Tizimlarimizda hech qanday muammo yo'q.";

        const st = data.status || '';
        if (st.includes('Partially') || st.includes('Degraded')) {
            bannerClass = 'degraded';
            bannerIcon = '⚠️';
            bannerTitle = 'Qisman tizim uzilishi';
            bannerSub = "Ba'zi xizmatlarda muammolar mavjud.";
        } else if (st.includes('Outage') || st.includes('Major')) {
            bannerClass = 'outage';
            bannerIcon = '🔴';
            bannerTitle = 'Jiddiy tizim uzilishi';
            bannerSub = "Tizimlarimizda keng ko'lamli muammolar mavjud.";
        }

        // Date range (7 days)
        let dateRangeStr = "So'nggi 7 kun";
        if (data.projects && data.projects.length > 0) {
            const comps = data.projects[0].components;
            if (comps && comps.length > 0 && comps[0].history && comps[0].history.length > 0) {
                const hist = comps[0].history;
                const d0 = fmtDate(hist[0].date);
                const d1 = fmtDate(hist[hist.length - 1].date);
                dateRangeStr = `${d0} – ${d1}`;
            }
        }

        // Overall uptime
        const upPct = typeof data.overall_uptime_pct === 'number' ? data.overall_uptime_pct.toFixed(3) : '—';
        const totalSvc = data.total_services || 0;
        const activeInc = data.active_incidents || 0;
        
        // Attention banner logic
        let issuesList = '';
        if (data.projects) {
            data.projects.forEach(p => {
                (p.components || []).forEach(c => {
                    const pct = typeof c.uptime_pct === 'number' ? c.uptime_pct : 100;
                    if (!c.is_up || pct < 99) {
                        issuesList += `<a href="#" onclick="openProjectModal('${p.slug}'); return false;">${escHtml(c.name)}</a> `;
                    }
                });
            });
        }
        let attentionHtml = '';
        if (issuesList !== '') {
            attentionHtml = `
            <div class="attention-banner visible fade-in">
                <div class="attention-title">⚠ Diqqat talab qiladi</div>
                <div class="attention-links">
                    Muammoli xizmatlar: ${issuesList}
                </div>
            </div>`;
        }

        let html = `
${attentionHtml}
<div class="status-banner ${bannerClass} fade-in">
    <div class="banner-body">
        <div class="banner-icon">${bannerIcon}</div>
        <div>
            <div class="banner-title">${escHtml(bannerTitle)}</div>
            <div class="banner-sub">${escHtml(bannerSub)}</div>
        </div>
    </div>
</div>

<div class="stats-row fade-in">
    <div class="stat-card">
        <div class="stat-label">7-Kunlik Uptime</div>
        <div class="stat-value">${upPct}<span>%</span></div>
        <div class="stat-sub">Barcha xizmatlar bo'yicha umumiy</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Faol xizmatlar</div>
        <div class="stat-value">${totalSvc}</div>
        <div class="stat-sub">Kuzatilayotgan komponentlar</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Faol muammolar</div>
        <div class="stat-value" style="color: ${activeInc > 0 ? 'var(--down)' : 'var(--up)'}">
            ${activeInc}
        </div>
        <div class="stat-sub">${activeInc === 0 ? 'Barcha tizimlar joyida' : 'Hozirda ishlamayotgan xizmatlar'}</div>
    </div>
</div>

<div class="status-card fade-in">
    <div class="filter-bar">
        <input type="text" id="search-input" class="search-input" placeholder="Komponentlarni izlash..." value="${escHtml(filterQuery)}" oninput="handleSearch(this.value)">
        <button id="toggle-issues-btn" class="toggle-btn ${showOnlyIssues ? 'active' : ''}" onclick="toggleIssues()">Faqat muammolarni ko'rsatish</button>
    </div>
    <div class="card-header">
        <div class="card-title">Tizim holati</div>
        <div class="date-range">‹ ${escHtml(dateRangeStr)} ›</div>
    </div>
`;

        if (!data.projects || data.projects.length === 0) {
            html += `<div style="padding: 48px; text-align:center; color:var(--text-muted)">Hali xizmatlar sozlanmagan.</div>`;
        } else {
            let visibleCount = 0;
            data.projects.forEach(proj => {
                let compHtml = '';
                let isProjUp = true;
                let isProjDown = false;
                
                (proj.components || []).forEach(comp => {
                    const q = filterQuery.toLowerCase();
                    const matchSearch = comp.name.toLowerCase().includes(q) || proj.name.toLowerCase().includes(q);
                    
                    const pct = typeof comp.uptime_pct === 'number' ? comp.uptime_pct : 100;
                    const hasIssue = !comp.is_up || pct < 99;
                    const matchFilter = !showOnlyIssues || hasIssue;
                    
                    if (matchSearch && matchFilter) {
                        compHtml += renderComponent(comp);
                        visibleCount++;
                    }
                    
                    if (!comp.is_up) isProjDown = true;
                    if (hasIssue) isProjUp = false;
                });
                
                if (compHtml !== '') {
                    html += `<div class="project-group">`;
                    if (data.projects.length > 1) {
                        let badgeHtml = '';
                        if (isProjDown) badgeHtml = '<span class="proj-badge down">Uzilish</span>';
                        else if (!isProjUp) badgeHtml = '<span class="proj-badge warn">Qisman uzilish</span>';
                        else badgeHtml = '<span class="proj-badge up">Ishlamoqda</span>';
                        
                        html += `<div class="project-label" style="cursor:pointer;" onclick="openProjectModal('${proj.slug}')">${escHtml(proj.name)} ${badgeHtml} <span style="font-size:9px; font-weight:normal; float:right;">Batafsil ko'rish uchun bosing</span></div>`;
                    }
                    html += compHtml;
                    html += `</div>`;
                }
            });
            if (visibleCount === 0) {
                html += `<div style="padding: 48px; text-align:center; color:var(--text-muted)">Qidiruvingizga mos komponent topilmadi.</div>`;
            }
        }

        html += `</div>`; // .status-card

        // Maintenance Logs
        html += renderMaintenanceLogsSection(data.maintenance_logs || []);

        // Recent Outages
        html += renderOutagesSection(data.recent_outages || []);

        root.innerHTML = html;
        
        // Re-focus search if it was active
        const searchInput = document.getElementById('search-input');
        if (searchInput && document.activeElement !== searchInput && filterQuery !== '') {
            searchInput.focus();
            searchInput.setSelectionRange(searchInput.value.length, searchInput.value.length);
        }
        document.getElementById('legend').style.display = 'flex';
    }

    let currentFilterQuery = '';
    let currentShowOnlyIssues = false;
    let currentModalSlug = '';
    
    function handleSearch(val) {
        currentFilterQuery = val;
        render(window.appData, currentFilterQuery, currentShowOnlyIssues);
    }
    
    function toggleIssues() {
        currentShowOnlyIssues = !currentShowOnlyIssues;
        render(window.appData, currentFilterQuery, currentShowOnlyIssues);
    }
    
    function renderComponent(comp) {
        const isUp = comp.is_up;
        const pct = typeof comp.uptime_pct === 'number' ? comp.uptime_pct : 100;
        const dotClass = isUp ? (pct < 100 ? 'warn' : 'up') : 'down';
        const statusText = isUp ? (pct < 99 ? 'Qisman uzilish' : 'Ishlamoqda') : 'Uzilish';
        const badgeClass = isUp ? '' : 'down';

        const downSecs = comp.total_downtime_secs || 0;
        const outCount = comp.total_outages || 0;
        const latency = comp.latency || 0;

        // Bars
        const history = comp.history || [];
        let barsHtml = '';
        history.forEach(day => {
            const p = typeof day.pct === 'number' ? day.pct : (day.is_up ? 100 : 0);
            let barClass = 'c-none';
            if (day.has_data === false) barClass = 'c-nodata';
            else if (p >= 100)      barClass = 'c-100';
            else if (p >= 90)  barClass = 'c-good';
            else if (p >= 50)  barClass = 'c-warn';
            else if (p > 0)    barClass = 'c-bad';
            else if (!day.is_up) barClass = 'c-bad';

            // Tooltip
            const dateFmt = fmtDate(day.date);
            let tipContent = `<div class="tip-date">${escHtml(dateFmt)}</div>`;

            if (day.has_data === false) {
                tipContent += `<div class="tip-uptime">Monitoring boshlanmagan</div>`;
            } else if (!day.outages || day.outages.length === 0) {
                tipContent += `<div class="tip-uptime">${p >= 100 ? '100.000' : p.toFixed(3)}% ishlash vaqti</div>`;
                tipContent += `<div class="tip-no-incidents">Bu kunda muammo bo'lmagan</div>`;
            } else {
                const totalDtSecs = day.outages.reduce((s, o) => s + o.duration_seconds, 0);
                tipContent += `<div class="tip-uptime">${p.toFixed(3)}% ishlash vaqti</div>`;
                day.outages.forEach(o => {
                    const dur = fmtDuration(o.duration_seconds);
                    const tStart = fmtTime(o.start);
                    const tEnd = fmtTime(o.end);
                    tipContent += `
<div class="tip-outage">
    <div>
        <div class="tip-outage-label">⚠ Uzilish &nbsp; ${escHtml(dur)}</div>
        <div class="tip-outage-time">${escHtml(tStart)} – ${escHtml(tEnd)}</div>
    </div>
</div>`;
                });
            }

            barsHtml += `<div class="bar ${barClass}"><div class="bar-tip">${tipContent}</div></div>`;
        });

        let metaStr = '';
        if (outCount > 0) {
            metaStr = `${outCount} uzilish, ${fmtDuration(downSecs)} ishlamadi`;
        } else {
            metaStr = "Belgilangan vaqt oralig'ida uzilishlar yo'q";
        }

        return `
<div class="comp-row">
    <div class="comp-info">
        <div class="comp-left">
            <div class="status-dot ${dotClass}"></div>
            <div class="comp-name">${escHtml(comp.name)}</div>
            <div class="comp-status-badge ${badgeClass}">${escHtml(statusText)}</div>
        </div>
        <div class="comp-right">
            ${latency > 0 ? `<div class="latency-badge">${latency}ms</div>` : ''}
            <div class="comp-meta">
                <strong>${pct.toFixed(3)}%</strong> ishlash vaqti<br>
                <span style="font-size:11px">${escHtml(metaStr)}</span>
            </div>
        </div>
    </div>
    <div class="bars-wrap">${barsHtml}</div>
    <div class="bars-label">
        <span>${history.length} kun oldin</span>
        <span>Bugun</span>
    </div>
</div>`;
    }

    async function openProjectModal(slug) {
        currentModalSlug = slug;
        document.getElementById('project-modal').classList.add('open');
        document.body.style.overflow = 'hidden';
        document.getElementById('modal-project-name').textContent = 'Yuklanmoqda...';
        loadProjectRange('7d');
    }
    
    function closeModal() {
        document.getElementById('project-modal').classList.remove('open');
        document.body.style.overflow = '';
        currentModalSlug = '';
        history.pushState('', document.title, window.location.pathname);
    }
    
    async function loadProjectRange(range) {
        if (!currentModalSlug) return;
        ['7d', '30d', '90d'].forEach(r => document.getElementById('tab-' + r).classList.remove('active'));
        document.getElementById('tab-' + range).classList.add('active');
        
        document.getElementById('modal-body-content').innerHTML = '<div style="padding: 24px; text-align: center; color: var(--text-muted);">Yuklanmoqda...</div>';
        
        try {
            const res = await fetch(`/api/public/status/project/${currentModalSlug}?range=${range}`);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();
            
            document.getElementById('modal-project-name').textContent = data.name;
            window.location.hash = '/project/' + currentModalSlug;
            
            let html = '';
            (data.components || []).forEach(comp => {
                html += renderComponent(comp);
            });
            if (!data.components || data.components.length === 0) {
                html += '<div style="padding: 24px; text-align: center;">Komponentlar topilmadi.</div>';
            }
            
            if (data.incidents && data.incidents.length > 0) {
                html += renderOutagesSection(data.incidents);
            }
            
            document.getElementById('modal-body-content').innerHTML = html;
        } catch (err) {
            document.getElementById('modal-body-content').innerHTML = `<div style="padding: 24px; text-align: center; color: var(--down);">Loyiha ma'lumotlarini yuklashda xatolik</div>`;
        }
    }

    function renderOutagesSection(outages) {
        let html = `
<div class="incidents-card fade-in">
    <div class="card-header">
        <div class="card-title">So'nggi muammolar</div>
        <div class="date-range">So'nggi 7 kun</div>
    </div>`;

        if (!outages || outages.length === 0) {
            html += `
<div class="incidents-empty">
    <div class="ei-icon">🎉</div>
    <div>So'nggi 7 kunda muammo kuzatilmadi</div>
    <div style="margin-top:6px; font-size:12px; color:var(--text-faint)">Barcha tizimlar barqaror ishlamoqda</div>
</div>`;
        } else {
            outages.forEach(o => {
                const dur = fmtDuration(o.duration_seconds);
                const startFmt = fmtDateTime(o.start);
                const endFmt = o.is_ongoing ? 'Davom etmoqda' : fmtDateTime(o.end);

                html += `
<div class="incident-row">
    <div class="incident-icon">${o.is_ongoing ? '🔴' : '⚠️'}</div>
    <div class="incident-body">
        <div class="incident-service">
            ${escHtml(o.service_name)}
            ${o.is_ongoing ? '<span class="ongoing-badge">Davom etmoqda</span>' : ''}
        </div>
        <div class="incident-time">${escHtml(startFmt)} → ${escHtml(endFmt)}</div>
    </div>
    <div class="incident-duration">${escHtml(dur)}</div>
</div>`;
            });
        }

        html += `</div>`;
        return html;
    }

    function renderMaintenanceLogsSection(logs) {
        let html = `
<div class="incidents-card fade-in">
    <div class="card-header">
        <div class="card-title">Tizim yangilanishlari (Restart)</div>
        <div class="date-range">Oxirgi hodisalar</div>
    </div>`;

        if (!logs || logs.length === 0) {
            html += `
<div class="incidents-empty" style="padding: 24px;">
    <div>Hozircha tizim yangilanishlari kuzatilmadi</div>
</div>`;
        } else {
            logs.forEach(log => {
                const dur = log.duration_seconds != null ? fmtDuration(log.duration_seconds) : '';
                const startFmt = fmtDateTime(log.started_at);
                const timeAgoStr = timeAgo(log.started_at);
                
                let icon = '🔄';
                if (log.event_type === 'start') icon = '▶️';
                else if (log.event_type === 'stop') icon = '⏹️';

                let title = log.service_name || 'Tizim';
                if (title.endsWith('.service')) title = title.replace('.service', '');
                
                let badgeClass = 'up';
                if (log.event_type === 'stop') badgeClass = 'down';

                html += `
<div class="incident-row">
    <div class="incident-icon">${icon}</div>
    <div class="incident-body">
        <div class="incident-service">
            ${escHtml(title)}
            <span class="proj-badge ${badgeClass}" style="font-size: 9px; padding: 1px 5px;">${escHtml(log.event_type || 'restart')}</span>
            <span style="font-size: 11px; color: var(--text-muted); margin-left: 6px; font-weight: normal;">${escHtml(timeAgoStr)}</span>
        </div>
        <div class="incident-time">${escHtml(startFmt)} - ${escHtml(log.description || 'Qayta ishga tushirildi')}</div>
    </div>
    <div class="incident-duration">${escHtml(dur)}</div>
</div>`;
            });
        }

        html += `</div>`;
        return html;
    }

    function renderError(msg) {
        root.innerHTML = `
<div class="status-banner outage fade-in">
    <div class="banner-body">
        <div class="banner-icon">🔴</div>
        <div>
            <div class="banner-title">Ulanish xatosi</div>
            <div class="banner-sub">Tizim holatini yuklab bo'lmadi. 30 soniyadan so'ng qayta uriniladi…</div>
        </div>
    </div>
</div>`;
        document.getElementById('last-updated-text').textContent = 'Ulanish xatosi';
    }

    // ── Init ───────────────────────────────────────────────
    fetchStatus();
    setInterval(fetchStatus, 30000);

    // Periodic "time ago" label refresh
    setInterval(() => {
        const el = document.getElementById('last-updated-text');
        if (el && window._lastUpdatedISO) {
            el.textContent = 'Yangilandi: ' + timeAgo(window._lastUpdatedISO);
        }
    }, 30000);

    // ── WebSocket ──────────────────────────────────────────
    function connectWS() {
        const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
        const ws = new WebSocket(`${proto}//${location.host}/ws`);
        let debounceTimer = null;

        ws.onopen = () => {
            console.log('[WS] Connected');
        };
        ws.onclose = () => {
            console.log('[WS] Disconnected, retrying in 5s…');
            setTimeout(connectWS, 5000);
        };
        ws.onmessage = () => {
            // Debounce — 2s interval'dan tez qayta fetch qilmaymiz
            if (debounceTimer) return;
            debounceTimer = setTimeout(() => {
                debounceTimer = null;
                fetchStatus();
            }, 2000);
        };
    }
    connectWS();
</script>
