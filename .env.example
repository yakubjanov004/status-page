PORT=8880
DB_PATH=./data/status.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secret

# Auto-Discovery uchun (birinchi ishga tushishda loyihalar avtomatik qo'shiladi)
DISCOVERY_NGINX_DIR=/etc/nginx/sites-enabled
DISCOVERY_SYSTEMD_DIR=/etc/systemd/system

# Telegram bildirishnomalar (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Status page brendi
SITE_NAME=Darrov Status
SITE_URL=https://status.darrov.uz

# Webhook receiver configuration
HOOK_TOKEN=change-me-to-a-secure-random-token
DATABASE_PATH=./data/status.db
LISTEN_ADDR=:8080

# Docker watcher configuration
WEBHOOK_URL=http://127.0.0.1:8080/api/v1/webhook
TOKPOINT_CONTAINER_NAME=tokpoint
TOKPOINT_SERVICE_NAME=Tokpoint

