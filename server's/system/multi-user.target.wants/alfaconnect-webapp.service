[Unit]
Description=AlfaConnect Next.js WebApp
Wants=network-online.target
After=network-online.target alfaconnect-bot.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/alfabot/webapp
EnvironmentFile=/root/alfabot/webapp/.env
Environment=NODE_ENV=production
Environment=PORT=5175
ExecStartPre=/usr/bin/test -d /root/alfabot/webapp/.next
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
