[Unit]                                                                                                                                                                                      
  Description=Mehmonxona Dashboard                                                                                                                                                            
  After=network.target postgresql.service                                                                                                                                                     
  Wants=postgresql.service                                                                                                                                                                    
                                                                                                                                                                                              
  [Service]                                                                                                                                                                                   
  Type=simple                                                                                                                                                                                 
  User=root                                                                                                                                                                                   
  WorkingDirectory=/root/Mehmonxona                                                                                                                                                           
  Environment=NODE_ENV=production                                                                                                                                                             
  EnvironmentFile=/root/Mehmonxona/.env                                                                                                                                                       
  ExecStart=/usr/bin/node backend/server.js                                                                                                                                                   
  Restart=always                                                                                                                                                                              
  RestartSec=5                                                                                                                                                                                
                                                                                                                                                                                              
  [Install]
  WantedBy=multi-user.target 
