[Unit]
Description=DSKTP3 backend API, Telegram bot, and background workers
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/dsktp3
EnvironmentFile=-/root/dsktp3/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/dsktp3/venv/bin/python /root/dsktp3/run.py
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
