upstream tokpoint_backend {
    server 127.0.0.1:8000;  # Docker exposed port
}

server {
    listen 80;
    server_name tokpointapi.darrov.uz;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name tokpointapi.darrov.uz;

    ssl_certificate /etc/letsencrypt/live/tokpointapi.darrov.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tokpointapi.darrov.uz/privkey.pem;

    client_max_body_size 20M;

    location / {
        proxy_pass http://tokpoint_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }

    location /ws {
        proxy_pass http://tokpoint_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location /media/ {
        alias /root/tokpoint/media/;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
}
