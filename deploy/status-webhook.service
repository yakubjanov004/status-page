[Unit]
Description=Status Page Webhook Receiver
Documentation=https://github.com/yakubjanov004/status-page
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=statuspage
Group=statuspage
WorkingDirectory=/opt/status-webhook
ExecStart=/usr/local/bin/status-webhook
Restart=always
RestartSec=5
EnvironmentFile=/opt/status-webhook/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=status-webhook

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=027

[Install]
WantedBy=multi-user.target
