[Unit]
Description=Status Page Webhook Receiver
Documentation=https://github.com/yakubjanov004/status-page
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Run as root if no dedicated user exists yet.
# To harden: useradd -r -s /bin/false statuspage
#            chown -R statuspage:statuspage /opt/status-webhook
#            then set User=statuspage Group=statuspage below
WorkingDirectory=/opt/status-webhook
ExecStart=/usr/local/bin/status-webhook
Restart=always
RestartSec=5
EnvironmentFile=/opt/status-webhook/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=status-webhook

# Basic security (compatible with root and non-root)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
