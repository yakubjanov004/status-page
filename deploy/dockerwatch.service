[Unit]
Description=Docker Container Watcher for Tokpoint
Documentation=https://github.com/yakubjanov004/status-page
# Start after both Docker daemon and tokpoint containers are up
Wants=network-online.target docker.service tokpoint-docker.service
After=network-online.target docker.service tokpoint-docker.service

[Service]
Type=simple
# Runs as root to access /var/run/docker.sock
# (root already has access on this server)
WorkingDirectory=/opt/status-webhook
EnvironmentFile=/opt/status-webhook/.env
# Override container name and service name via env file if needed:
#   TOKPOINT_CONTAINER_NAME=tokpoint-backend-1
#   TOKPOINT_SERVICE_NAME=Tokpoint
ExecStart=/usr/local/bin/docker-watcher
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=docker-watcher

[Install]
WantedBy=multi-user.target
